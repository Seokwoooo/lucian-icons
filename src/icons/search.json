{
  "id": "search",
  "name": {
    "ko": "검색",
    "en": "Search"
  },
  "keywords": [
    "찾기",
    "탐색",
    "돋보기",
    "find",
    "query",
    "lookup"
  ],
  "category": "navigation",
  "version": "1.2.0",
  "accent": "#9fb9d4",
  "defaultState": "idle",
  "triggers": [
    "click",
    "controlled"
  ],
  "duration": 300,
  "description": {
    "ko": "돋보기의 렌즈에 색이 들어오고 빛이 가장자리를 따라 움직입니다.",
    "en": "The lens gains color as a reflection travels around its edge."
  },
  "parts": {
    "lens": {
      "fill": "var(--li-paper)"
    },
    "shine": {
      "opacity": ".45",
      "stroke": "var(--li-ink)",
      "transformOrigin": "20px 20px",
      "transform": "rotate(0deg)"
    }
  },
  "states": {
    "idle": {},
    "searching": {
      "lens": {
        "fill": "var(--li-accent)"
      },
      "shine": {
        "opacity": ".6",
        "stroke": "var(--li-ink)",
        "transform": "rotate(35deg)"
      }
    }
  },
  "css": "svg[data-state=searching] [data-part=shine]{animation:li-search-reflection 560ms cubic-bezier(.2,.7,.2,1)}@keyframes li-search-reflection{0%{transform:rotate(0deg)}65%{transform:rotate(105deg)}100%{transform:rotate(35deg)}}",
  "svg": "<path d=\"m29.5 32.5 8.3 8.3a2.1 2.1 0 0 0 3-3l-8.3-8.3z\" fill=\"var(--li-accent)\"/><circle data-part=\"lens\" cx=\"20\" cy=\"20\" r=\"13.5\"/><path data-part=\"shine\" d=\"M12 20a8 8 0 0 1 8-8\"/>",
  "order": 9,
  "stateLabels": {
    "ko": {
      "idle": "대기",
      "searching": "검색 중"
    },
    "en": {
      "idle": "Idle",
      "searching": "Searching"
    }
  }
}
