{
  "id": "search",
  "name": {
    "ko": "검색",
    "en": "Search"
  },
  "keywords": [
    "찾기",
    "탐색",
    "돋보기",
    "find",
    "query",
    "lookup"
  ],
  "category": "controls",
  "version": "1.1.0",
  "accent": "#9fb9d4",
  "defaultState": "idle",
  "triggers": [
    "click",
    "controlled"
  ],
  "duration": 300,
  "description": {
    "ko": "렌즈 안의 작은 빛이 검색 시작을 알립니다.",
    "en": "A quiet sweep inside the lens signals a new search."
  },
  "parts": {
    "lens": {
      "fill": "var(--li-paper)"
    },
    "sweep": {
      "opacity": "0",
      "transform": "translateX(-5px)"
    },
    "shine": {
      "opacity": ".35"
    }
  },
  "states": {
    "idle": {},
    "searching": {
      "lens": {
        "fill": "var(--li-accent)"
      },
      "sweep": {
        "opacity": ".8",
        "transform": "translateX(0px)"
      },
      "shine": {
        "opacity": "0"
      }
    }
  },
  "css": "svg[data-state=searching] [data-part=sweep]{animation:li-search 650ms ease-in-out}@keyframes li-search{0%{transform:translateX(-5px);opacity:0}55%{transform:translateX(5px);opacity:.8}100%{transform:translateX(0px);opacity:.8}}",
  "svg": "<path d=\"m31 31 10 10\" stroke-width=\"6\"/><path d=\"m33 33 7 7\" stroke=\"var(--li-accent)\" stroke-width=\"3\"/><circle data-part=\"lens\" cx=\"21\" cy=\"21\" r=\"14\"/><path data-part=\"shine\" d=\"M13 21a8 8 0 0 1 8-8\"/><path data-part=\"sweep\" d=\"M21 13v16\" stroke=\"var(--li-paper)\" stroke-width=\"3\"/>",
  "order": 9
}
